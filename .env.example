# true 时命令行申购/兑换/划转只打印，不真实下单。操作台仍要在页面确认才下单
LICAI_DRY_RUN=true

# 操作台访问密码。不设这个，web 起不来；没密码也看不到任何接口
LICAI_DASHBOARD_PASSWORD=

# Webshare 代理 API Token（https://apidocs.webshare.io/proxy-list/list）
# 配置后：添加账号留空代理会自动分配；页面也可点「Webshare 分配」
WEBSHARE_API_TOKEN=
# WEBSHARE_MODE=direct
# WEBSHARE_COUNTRY=US
# WEBSHARE_AUTO_ASSIGN=true
